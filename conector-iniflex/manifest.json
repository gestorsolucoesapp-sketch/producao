{
  "manifest_version": 3,
  "name": "Conector Iniflex Rioplastic",
  "version": "0.1.0",
  "description": "Conecta o app Rioplastic à sessão do Iniflex já aberta neste navegador.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://sistema.rioplastic.com.br/*",
    "https://gestorsolucoesapp-sketch.github.io/producao/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Conector Iniflex Rioplastic",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://gestorsolucoesapp-sketch.github.io/producao/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
