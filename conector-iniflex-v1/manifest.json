{
  "manifest_version": 3,
  "name": "Rioplastic · Supervisor Iniflex v1",
  "version": "1.0.0",
  "description": "Supervisor determinístico dos 14 relatórios Iniflex. O Supabase decide a sequência e só avança após importação certificada.",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": [
    "https://sistema.rioplastic.com.br/*",
    "https://gestorsolucoesapp-sketch.github.io/producao/*",
    "https://bweblwmgwutzdvqtpbww.supabase.co/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://gestorsolucoesapp-sketch.github.io/producao/*"],
      "js": ["controller.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Supervisor Iniflex v1",
    "default_popup": "popup.html"
  }
}