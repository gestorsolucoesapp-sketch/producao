{
  "manifest_version": 3,
  "name": "Rioplastic · Supervisor Iniflex v1.1",
  "version": "1.1.0",
  "description": "Supervisor dos 14 relatórios Iniflex com sequência certificada, retentativas e retomada automática.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://sistema.rioplastic.com.br/*",
    "https://gestorsolucoesapp-sketch.github.io/producao/*",
    "https://bweblwmgwutzdvqtpbww.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gestorsolucoesapp-sketch.github.io/producao/*"
      ],
      "js": [
        "controller.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Supervisor Iniflex v1",
    "default_popup": "popup.html"
  }
}
